# Environment Configuration for GoldenHour Backend

ENVIRONMENT=development
DEBUG=True

# Anthropic Claude API Key (Required for live Claude Vision and text extraction)
# In development, leave blank to use the built-in mock AI analysis engine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Supabase Configuration (Optional - falls back to secure local storage and in-memory mock if omitted)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_EVIDENCE=evidence-vault

# File Upload Settings
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads
